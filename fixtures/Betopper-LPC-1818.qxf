  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="10">No function</Capability>
  <Capability Min="11" Max="255">Color macros and auto programs</Capability>
 </Channel>
 <Channel Name="Auto Speed / Sound Sensitivity">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="255">Speed slow to fast / Sensitivity low to high</Capability>
 </Channel>
 <Channel Name="Dimmer Curve">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Dimmer curves / response speed</Capability>
 </Channel>
